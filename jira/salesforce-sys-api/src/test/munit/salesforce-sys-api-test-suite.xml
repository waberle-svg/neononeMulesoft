<?xml version="1.0" encoding="UTF-8"?>
<!--
  MUnit suite for salesforce-sys-api. Every Salesforce and process-API call is mocked by its doc:name, so no network,
  no keystore and no connected app are needed. MUnit disables flow sources (the platform-event listener and the
  scheduler) by default, so those flows are exercised through their inner flows.

  Sample payloads: src/test/resources/samples.
   - Salesforce connector results are Java structures -> readUrl(...) tagged application/java.
   - HTTP bodies are JSON text -> MunitTools::getResourceAsString(...) tagged application/json (see ERR-0007).
  Run: mvn clean test
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="salesforce-sys-api-test-suite.xml"/>

    <!-- ===== ping ===== -->
    <munit:test name="ping-returns-ok" description="GET /ping returns status ok with app metadata">
        <munit:execution>
            <flow-ref name="get:\ping:salesforce-sys-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('ok')]"/>
            <munit-tools:assert-that expression="#[payload.app]" is="#[MunitTools::equalTo('salesforce-sys-api')]"/>
        </munit:validation>
    </munit:test>

    <!-- ===== GET /opportunities/{id} ===== -->
    <munit:test name="get-opportunity-maps-row-to-canonical"
                description="A query row becomes the canonical Opportunity (nested account, contacts, extra fields)">
        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:query">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="SF: query Opportunity"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[readUrl('classpath://samples/sf-opportunity-rows.json', 'application/json')]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
                    <munit:variable key="opportunityId" value="006Su00000XPwLxIAL"/>
                </munit:variables>
            </munit:set-event>
            <flow-ref name="sf-get-opportunity"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('006Su00000XPwLxIAL')]"/>
            <munit-tools:assert-that expression="#[payload.opportunityNumber]" is="#[MunitTools::equalTo('O-0210538')]"/>
            <munit-tools:assert-that expression="#[payload.account.name]" is="#[MunitTools::equalTo('Acme Nonprofit')]"/>
            <munit-tools:assert-that expression="#[payload.primaryContact.email]" is="#[MunitTools::equalTo('pat@example.org')]"/>
            <!-- requirements v3 (Swati, 5 Oct 2026): the technical contact is the ACCOUNT's; the Opportunity's own lookup is blank here -->
            <munit-tools:assert-that expression="#[payload.technicalContact.email]" is="#[MunitTools::equalTo('devonna.dionne@example.org')]"/>
            <munit-tools:assert-that expression="#[payload.opportunityTechnicalContact]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[payload.account.nteeCode]" is="#[MunitTools::equalTo('S22')]"/>
            <munit-tools:assert-that expression="#[payload.account.billingCountry]" is="#[MunitTools::equalTo('United States')]"/>
            <munit-tools:assert-that expression="#[payload.partnerContact]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[payload.includesWebTemplateCopy]" is="#[MunitTools::equalTo(1)]"/>
            <!-- config-test.yaml sets sf.opportunity.extraFields = BusinessUnit__c -->
            <munit-tools:assert-that expression="#[payload.extra.BusinessUnit__c]" is="#[MunitTools::equalTo('01 NeonCRM')]"/>
            <!-- Scenario 2 view: trigger fields, per-line instance ids (blank -> null, Number -> whole-number text), write-back pairs -->
            <munit-tools:assert-that expression="#[payload.riskStage]" is="#[MunitTools::equalTo('Closed/Churn')]"/>
            <munit-tools:assert-that expression="#[payload.forecastOpportunity]" is="#[MunitTools::equalTo(true)]"/>
            <munit-tools:assert-that expression="#[payload.account.ncrmInstance]" is="#[MunitTools::equalTo('acmenonprofit')]"/>
            <munit-tools:assert-that expression="#[payload.account.rbId]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[payload.account.artsPeopleTheatreId]" is="#[MunitTools::equalTo('1376')]"/>
            <!-- the sample row carries the date as a midnight timestamp (one of the shapes the connector can return): the contract is still yyyy-MM-dd -->
            <munit-tools:assert-that expression="#[payload.account.deactivationDate as String]" is="#[MunitTools::equalTo('2027-09-22')]"/>
            <munit-tools:assert-that expression="#[payload.closeDate as String]" is="#[MunitTools::equalTo('2026-09-18')]"/>
            <munit-tools:assert-that expression="#[payload.account.cancellationStatus]" is="#[MunitTools::equalTo('Partial Cancellation')]"/>
            <munit-tools:assert-that expression="#[payload.deactivation.neonCrm.jiraKey]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[payload.deactivation.neonFundraise.jiraKey]" is="#[MunitTools::equalTo('NSSU-9')]"/>
            <munit-tools:assert-that expression="#[payload.deactivation.artsPeople.error]" is="#[MunitTools::containsString('MISSING_INSTANCE_ID')]"/>
        </munit:validation>
    </munit:test>

