                <munit-tools:then-return>
                    <munit-tools:payload value="#[readUrl('classpath://samples/sf-registry-rows.json', 'application/json')]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
