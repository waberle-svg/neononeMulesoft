            <munit-tools:assert-that expression="#[payload[0].id]" is="#[MunitTools::equalTo('a0BSu000001abcdMAA')]"/>
            <munit-tools:assert-that expression="#[vars.soql]" is="#[MunitTools::containsString(&quot;Opportunity__c = ':opportunityId'&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.soql]" is="#[MunitTools::containsString(&quot;External_Status_Category__c != ':excludeCategory'&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.soql]" is="#[MunitTools::not(MunitTools::containsString('006Su00000XPwLxIAL'))]"/>
