    <!-- ===== PATCH /integration-requests/{id} ===== -->
    <munit:test name="patch-registry-builds-record-with-fields-to-null"
                description="Canonical update -> SF record: known keys mapped, unknown ignored, explicit nulls become fieldsToNull">
        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="SF: update Integration_Transaction__c"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{ id: 'a0BSu000001abcdMAA', success: true, errors: [] }]]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:spy processor="salesforce:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="SF: update Integration_Transaction__c"/>
                </munit-tools:with-attributes>
                <munit-tools:before-call>
                    <munit-tools:store key="sentRecords">
                        <munit-tools:value>#[payload]</munit-tools:value>
                    </munit-tools:store>
                </munit-tools:before-call>
            </munit-tools:spy>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
                    <munit:variable key="recordId" value="a0BSu000001abcdMAA"/>
                    <munit:variable key="updateBody" value="#[readUrl('classpath://samples/integration-request-patch.json', 'application/json')]"/>
                </munit:variables>
            </munit:set-event>
            <flow-ref name="registry-update"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:retrieve key="sentRecords" target="sent"/>
            <munit-tools:assert-that expression="#[sizeOf(vars.sent)]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].Id]" is="#[MunitTools::equalTo('a0BSu000001abcdMAA')]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].Request_Status__c]" is="#[MunitTools::equalTo('Created')]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].Attempts__c]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].External_Key__c]" is="#[MunitTools::equalTo('NSSU-42')]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].External_Status_Category__c]" is="#[MunitTools::equalTo('To Do')]"/>
            <!-- Scenario 2: the resolved product line is written to Product_Line__c -->
            <munit-tools:assert-that expression="#[vars.sent[0].Product_Line__c]" is="#[MunitTools::equalTo('Neon CRM')]"/>
            <!-- lastError: null clears both the long text and its Text(255) shadow (ERR-0013) -->
            <munit-tools:assert-that expression="#[vars.sent[0].fieldsToNull]" is="#[MunitTools::equalTo(['Last_Error__c', 'Last_Error_Short__c'])]"/>
            <!-- DateTime fields must reach the connector typed, not as strings (ERR-0011) -->
            <munit-tools:assert-that expression="#[vars.sent[0].Status_Changed_At__c is DateTime]" is="#[MunitTools::equalTo(true)]"/>
            <munit-tools:assert-that expression="#[vars.sent[0].notAWritableField]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[vars.writeResult.success]" is="#[MunitTools::equalTo(true)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="patch-registry-rejected-by-salesforce-raises-write-rejected"
                description="success=false from Salesforce -> APP:WRITE_REJECTED (422, not retryable)"
                expectedErrorType="APP:WRITE_REJECTED">
