    <!-- ===== Platform event -> ProvisioningRequested -> process API ===== -->
    <munit:test name="event-is-forwarded-as-provisioning-requested"
                description="An Integration_Request__e for JIRA is normalised and POSTed to the process API">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="prc: POST provisioning-requests"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[output application/json --- { outcome: "ACCEPTED" }]' mediaType="application/json"/>
                    <munit-tools:attributes value="#[{ statusCode: 202, reasonPhrase: 'Accepted', headers: {} }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:spy processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="prc: POST provisioning-requests"/>
                </munit-tools:with-attributes>
                <munit-tools:before-call>
                    <munit-tools:store key="forwardedRequest">
                        <munit-tools:value>#[vars.request]</munit-tools:value>
                    </munit-tools:store>
                </munit-tools:before-call>
            </munit-tools:spy>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[readUrl('classpath://samples/integration-request-event.json', 'application/json')]" mediaType="application/java"/>
            </munit:set-event>
            <flow-ref name="handle-integration-request-event"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:retrieve key="forwardedRequest" target="sent"/>
            <munit-tools:assert-that expression="#[vars.sent.requestId]" is="#[MunitTools::equalTo('a0BSu000001abcdMAA')]"/>
            <munit-tools:assert-that expression="#[vars.sent.targetSystem]" is="#[MunitTools::equalTo('JIRA')]"/>
            <munit-tools:assert-that expression="#[vars.sent.requestType]" is="#[MunitTools::equalTo('PROVISIONING')]"/>
            <munit-tools:assert-that expression="#[vars.sent.sourceRecordId]" is="#[MunitTools::equalTo('006Su00000XPwLxIAL')]"/>
            <munit-tools:assert-that expression="#[vars.sent.replayId]" is="#[MunitTools::equalTo(42)]"/>
            <munit-tools:assert-that expression="#[vars.sent.payload.priority]" is="#[MunitTools::equalTo('normal')]"/>
            <munit-tools:assert-that expression="#[vars.forwarded]" is="#[MunitTools::equalTo(true)]"/>
            <munit-tools:verify-call processor="os:store" times="0"/>
        </munit:validation>
    </munit:test>

    <munit:test name="event-for-another-target-system-is-ignored"
                description="Target_System__c not in sf.events.targetSystems -> nothing is forwarded or parked">
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[{ payload: { Target_System__c: 'ROCKETLANE', Request_Type__c: 'PROVISIONING', Request_Id__c: 'a0BSu000001zzzzMAA' }, event: { replayId: 43 } }]" mediaType="application/java"/>
            </munit:set-event>
            <flow-ref name="handle-integration-request-event"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="http:request" times="0"/>
            <munit-tools:verify-call processor="os:store" times="0"/>
            <munit-tools:assert-that expression="#[vars.forwarded]" is="#[MunitTools::equalTo(false)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="undeliverable-event-is-parked-not-lost"
                description="When the process API keeps failing, the request is stored in the Object Store under its requestId">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="prc: POST provisioning-requests"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="os:store">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Park in Object Store"/>
                </munit-tools:with-attributes>
            </munit-tools:mock-when>
            <munit-tools:spy processor="os:store">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Park in Object Store"/>
                </munit-tools:with-attributes>
                <munit-tools:before-call>
                    <munit-tools:store key="parkedRequestId">
                        <munit-tools:value>#[vars.request.requestId]</munit-tools:value>
                    </munit-tools:store>
                </munit-tools:before-call>
            </munit-tools:spy>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[readUrl('classpath://samples/integration-request-event.json', 'application/json')]" mediaType="application/java"/>
            </munit:set-event>
            <flow-ref name="handle-integration-request-event"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="os:store" times="1"/>
            <munit-tools:retrieve key="parkedRequestId" target="parkedId"/>
            <munit-tools:assert-that expression="#[vars.parkedId]" is="#[MunitTools::equalTo('a0BSu000001abcdMAA')]"/>
            <munit-tools:assert-that expression="#[vars.forwarded]" is="#[MunitTools::equalTo(false)]"/>
        </munit:validation>
    </munit:test>

    <!-- ===== Scenario 1, Order model (requirements v3, 5 Oct 2026): GET /orders/{id} ===== -->
    <munit:test name="get-order-maps-rows-to-canonical"
                description="Order header + Order Products selected through the Product + the Account's additional users become the canonical Order">
        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:query">
