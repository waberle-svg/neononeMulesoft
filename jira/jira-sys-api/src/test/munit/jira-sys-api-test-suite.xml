            <munit-tools:assert-that expression="#[payload[0].status.name]" is="#[MunitTools::equalTo('Open')]"/>
            <munit-tools:assert-that expression="#[payload[0].sfOpportunityId]" is="#[MunitTools::equalTo('006Su00000Xd0ehIAB')]"/>
            <munit-tools:assert-that expression="#[payload[0].created as String]" is="#[MunitTools::startsWith('2026-09-29T06:24:22')]"/>
        </munit:validation>
    </munit:test>

    <!-- ===== Requirements v3 (5 Oct 2026): System Setup ticket with the Order-model fields and a per-request reporter ===== -->
    <munit:test name="create-system-setup-v3-sends-new-fields-and-request-reporter"
                description="Implementation Type (option), Operating Country, NTEE, Additional Users and labels reach Jira under their field ids; the request's reporter wins over the environment default">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Jira: POST /issue"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[MunitTools::getResourceAsString('samples/jira-create-201.json')]" mediaType="application/json"/>
                    <munit-tools:attributes value="#[{ statusCode: 201, reasonPhrase: 'Created', headers: {} }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Jira: PUT /issue/{key}/assignee"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#['']" mediaType="text/plain"/>
                    <munit-tools:attributes value="#[{ statusCode: 204, reasonPhrase: 'No Content', headers: {} }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:spy processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Jira: POST /issue"/>
                </munit-tools:with-attributes>
                <munit-tools:before-call>
                    <munit-tools:store key="jiraPayloadV3"><munit-tools:value>#[payload]</munit-tools:value></munit-tools:store>
                </munit-tools:before-call>
            </munit-tools:spy>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[MunitTools::getResourceAsString('samples/issue-create-request-setup-v3.json')]" mediaType="application/json"/>
            </munit:set-event>
            <flow-ref name="jira-create-issue"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:retrieve key="jiraPayloadV3" target="sent"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.summary]" is="#[MunitTools::equalTo('Acme Nonprofit')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15343.value]" is="#[MunitTools::equalTo('Assisted Self Import')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15228]" is="#[MunitTools::equalTo('United States')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15364]" is="#[MunitTools::equalTo('S22')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15365]" is="#[MunitTools::equalTo('Community Improvement, Capacity Building')]"/>
            <!-- Additional Users is a textarea field: sent as an ADF document, one paragraph per line (ERR-0024) -->
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15316.'type']" is="#[MunitTools::equalTo('doc')]"/>
            <munit-tools:assert-that expression="#[sizeOf(vars.sent.fields.customfield_15316.content)]" is="#[MunitTools::equalTo(2)]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15316.content[0].content[0].text]" is="#[MunitTools::containsString('Ellen Clark &lt;ellen.clark@example.org&gt;')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15316.content[1].content[0].text]" is="#[MunitTools::containsString('Ashley Peska')]"/>
            <!-- description markup -> ADF (modules::Adf): bold label + line break + underlined name in one paragraph,
                 e-mail as a mailto paragraph, the Sales Notes block as a bullet list, bold section header + value -->
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[0].content[0].text]" is="#[MunitTools::equalTo('Primary Contact')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[0].content[0].marks[0].'type']" is="#[MunitTools::equalTo('strong')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[0].content[1].'type']" is="#[MunitTools::equalTo('hardBreak')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[0].content[2].text]" is="#[MunitTools::equalTo('Pat Example')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[0].content[2].marks[0].'type']" is="#[MunitTools::equalTo('underline')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[1].content[0].marks[0].attrs.href]" is="#[MunitTools::equalTo('mailto:pat@example.org')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[5].'type']" is="#[MunitTools::equalTo('bulletList')]"/>
            <munit-tools:assert-that expression="#[sizeOf(vars.sent.fields.description.content[5].content)]" is="#[MunitTools::equalTo(2)]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[6].content[2].text]" is="#[MunitTools::equalTo('S22 Community Improvement, Capacity Building')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.description.content[7].content[2].text]" is="#[MunitTools::equalTo('Salesforce Order Id - 801Su000001OrdAIAS')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15204]" is="#[MunitTools::equalTo('Core CRM Subscription Fee, Neon CRM SimpleStart')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15259]" is="#[MunitTools::equalTo('Devonna Dionne')]"/>
            <munit-tools:assert-that expression="#[vars.sent.fields.labels]" is="#[MunitTools::equalTo(['sf-setup-801Su000001OrdAIAS-neon_crm', 'sf-setup'])]"/>
            <!-- the request's reporter (Natalie) beats the environment default (test-reporter-account-id) -->
            <munit-tools:assert-that expression="#[vars.sent.fields.reporter.accountId]" is="#[MunitTools::equalTo('60a27983391e56006e52cca8')]"/>
            <!-- no NTEE Category was supplied: the key is absent, not null -->
            <munit-tools:assert-that expression="#[vars.sent.fields.customfield_15314?]" is="#[MunitTools::equalTo(false)]"/>
        </munit:validation>
    </munit:test>

