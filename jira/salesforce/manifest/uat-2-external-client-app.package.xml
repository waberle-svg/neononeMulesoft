<?xml version="1.0" encoding="UTF-8"?>
<!-- UAT package 2 of 2 — the External Client App "Neon Jira Integration" (JWT bearer login for salesforce-sys-api).
     Deploy AFTER package 1 and AFTER replacing the <certificate> in
       force-app/main/default/extlClntAppGlobalOauthSets/Neon_Jira_Integration_glbloauth.ecaGlblOauth-meta.xml
     with the UAT certificate (public half of the UAT key pair). The consumer key is generated by the org on creation and
     is read back afterwards (metadata retrieve of ExtlClntAppOauthSettings) — never typed, never pasted.
     Step 2 (policies) is a separate manifest because the policy references the app, which must exist first:
       manifest/neon-jira-integration-step2-eca-policies.package.xml -->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Neon_Jira_Integration</members>
        <name>ExternalClientApplication</name>
    </types>
    <types>
        <members>Neon_Jira_Integration_glbloauth</members>
        <name>ExtlClntAppGlobalOauthSettings</name>
    </types>
    <types>
        <members>Neon_Jira_Integration_oauth</members>
        <name>ExtlClntAppOauthSettings</name>
    </types>
    <version>68.0</version>
</Package>
