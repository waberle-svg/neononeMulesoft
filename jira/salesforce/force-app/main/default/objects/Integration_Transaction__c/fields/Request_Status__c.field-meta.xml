    <trackHistory>true</trackHistory>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
                <value><fullName>Requested</fullName><default>false</default><label>Requested</label></value>
                <value><fullName>Created</fullName><default>false</default><label>Created</label></value>
                <value><fullName>Failed - Terminal</fullName><default>false</default><label>Failed - Terminal</label></value>
                <value><fullName>Retrying</fullName><default>false</default><label>Retrying</label></value>
                <value><fullName>Cancelled</fullName><default>false</default><label>Cancelled</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
