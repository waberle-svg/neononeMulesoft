    <description>Subflow of the Scenario 2 (cancellation) trigger. For ONE product line of a churned Opportunity: create an Integration_Transaction__c row (JIRA / DEACTIVATION / Requested, keyed by Group_Key__c = OpportunityId:DEACTIVATION:LINE) and publish an Integration_Request__e event for MuleSoft. Idempotent: an existing Requested/Retrying/Created/Cancelled row is left alone; an existing Failed - Terminal row is reset to Requested (errors cleared) and re-published, which is the Salesforce-side retry. Faults never reach the user: a duplicate Group Key (race) ends quietly, any other failure is written to the line's Cancellation Error field on the Opportunity.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_GroupKey</name>
        <dataType>String</dataType>
        <expression>{!in_OpportunityId} &amp; ":DEACTIVATION:" &amp; UPPER(SUBSTITUTE(TRIM({!in_ProductLine}), " ", "_"))</expression>
    </formulas>
    <formulas>
        <name>fx_InstanceIdJson</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!in_InstanceId}, "\\", "\\\\"), "\"", "\\\"")</expression>
    </formulas>
    <formulas>
        <name>fx_CancellationStatusJson</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!in_CancellationStatus}, "\\", "\\\\"), "\"", "\\\"")</expression>
    </formulas>
    <formulas>
        <name>fx_PayloadJson</name>
        <dataType>String</dataType>
        <expression>'{"productLine":"' &amp; {!in_ProductLine} &amp; '","instanceId":"' &amp; {!fx_InstanceIdJson} &amp; '","deactivationDate":"' &amp; IF(ISBLANK({!in_DeactivationDate}), "", TEXT({!in_DeactivationDate})) &amp; '","cancellationStatus":"' &amp; {!fx_CancellationStatusJson} &amp; '"}'</expression>
    </formulas>
    <formulas>
        <name>fx_IsDuplicateFault</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!var_FaultMessage}, "DUPLICATE_VALUE")</expression>
    </formulas>
    <formulas>
        <name>fx_FaultShort</name>
        <dataType>String</dataType>
        <expression>LEFT("Deactivation request could not be created: " &amp; {!var_FaultMessage}, 255)</expression>
    </formulas>
