        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  ISPICKVAL({!$Record.Target_System__c}, "JIRA"),
  OR(
    ISPICKVAL({!$Record.Request_Type__c}, "PROVISIONING"),
    ISPICKVAL({!$Record.Request_Type__c}, "DEACTIVATION")
  ),
  NOT(ISBLANK({!$Record.Opportunity__c})),
  OR(
    ISNEW(),
    ISCHANGED({!$Record.External_Key__c}),
    ISCHANGED({!$Record.External_Status__c}),
    ISCHANGED({!$Record.External_Status_Id__c}),
    ISCHANGED({!$Record.Status_Changed_At__c}),
    ISCHANGED({!$Record.Request_Status__c}),
    ISCHANGED({!$Record.Last_Error_Short__c})
  )
)</filterFormula>
