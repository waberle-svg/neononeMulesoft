<?xml version="1.0" encoding="UTF-8"?>
<!--
  common/error-handler.xml — canonical error shape for every failure that escapes a flow.
  { code, message, retryable, correlationId, detail }
  For downstream (system API) failures the canonical error THEY returned is surfaced in detail.backend, and their
  `retryable` verdict is respected when present.
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <error-handler name="global-error-handler">

        <!-- Caller's request did not match the RAML -->
        <on-error-propagate type="APIKIT:BAD_REQUEST">
            <set-variable variableName="errCode" value="VALIDATION"/>
            <set-variable variableName="errStatus" value="400"/>
            <set-variable variableName="errRetryable" value="#[false]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>
        <on-error-propagate type="APIKIT:NOT_FOUND">
            <set-variable variableName="errCode" value="NOT_FOUND"/>
            <set-variable variableName="errStatus" value="404"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>
        <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED, APIKIT:NOT_ACCEPTABLE, APIKIT:UNSUPPORTED_MEDIA_TYPE, APIKIT:NOT_IMPLEMENTED">
            <set-variable variableName="errCode" value="VALIDATION"/>
            <set-variable variableName="errStatus" value="405"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>

        <on-error-propagate type="APP:UNAUTHORIZED_CALLER">
            <set-variable variableName="errCode" value="UNAUTHORIZED"/>
            <set-variable variableName="errStatus" value="401"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>

        <!-- A system API rejected our call: our bug or a data problem, not retryable -->
        <on-error-propagate type="HTTP:BAD_REQUEST, HTTP:UNAUTHORIZED, HTTP:FORBIDDEN, HTTP:NOT_FOUND, HTTP:METHOD_NOT_ALLOWED, HTTP:NOT_ACCEPTABLE, HTTP:UNSUPPORTED_MEDIA_TYPE, HTTP:CLIENT_SECURITY">
            <set-variable variableName="errCode" value="INTERNAL"/>
            <set-variable variableName="errStatus" value="502"/>
            <set-variable variableName="errRetryable" value="#[false]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>

        <!-- Transient downstream problems: the caller may retry -->
        <on-error-propagate type="HTTP:TOO_MANY_REQUESTS">
            <set-variable variableName="errCode" value="RATE_LIMITED"/>
            <set-variable variableName="errStatus" value="429"/>
            <set-variable variableName="errRetryable" value="#[true]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>
        <on-error-propagate type="HTTP:TIMEOUT">
            <set-variable variableName="errCode" value="BACKEND_TIMEOUT"/>
            <set-variable variableName="errStatus" value="504"/>
            <set-variable variableName="errRetryable" value="#[true]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>
        <on-error-propagate type="HTTP:CONNECTIVITY, HTTP:RETRY_EXHAUSTED, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE, HTTP:GATEWAY_TIMEOUT">
            <set-variable variableName="errCode" value="BACKEND_UNAVAILABLE"/>
            <set-variable variableName="errStatus" value="502"/>
            <set-variable variableName="errRetryable" value="#[true]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>

        <!-- Our own bug (bad DataWeave, missing property, bad mapping file): not retryable -->
        <on-error-propagate type="MULE:EXPRESSION, MULE:TRANSFORMATION">
            <set-variable variableName="errCode" value="INTERNAL"/>
            <set-variable variableName="errStatus" value="500"/>
            <set-variable variableName="errRetryable" value="#[false]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>

        <on-error-propagate type="ANY">
            <set-variable variableName="errCode" value="INTERNAL"/>
            <set-variable variableName="errStatus" value="500"/>
            <set-variable variableName="errRetryable" value="#[true]"/>
            <flow-ref name="build-error-response"/>
        </on-error-propagate>
    </error-handler>

    <sub-flow name="build-error-response">
        <set-variable variableName="httpStatus" value="#[vars.errStatus default 500]"/>
        <ee:transform doc:name="Canonical error">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import try from dw::Runtime
output application/json skipNullOn="everywhere"
var backend = try(() -> error.errorMessage.payload)
var backendBody = if (backend.success) backend.result else null
---
{
  code: vars.errCode default "INTERNAL",
  message: backendBody.message default error.description default "Unexpected error",
  retryable: vars.errRetryable default false,
  correlationId: correlationId,
  detail: {
    errorType: (error.errorType.namespace default "") ++ ":" ++ (error.errorType.identifier default ""),
    backend: backendBody
  }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <logger level="ERROR" doc:name="Log error"
                message='#[output text/plain --- "provisioning-prc-api error " ++ (vars.errCode default "INTERNAL") ++ " (" ++ (vars.httpStatus as String) ++ "): " ++ (error.description default "")]'/>
    </sub-flow>

</mule>
